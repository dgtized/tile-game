#!/usr/bin/env bash

# mostly-deprecated, this is used by circleci
set -exuo pipefail

mkdir -p test-results/{kaocha,coverage}
clojure -Mkaocha --config-file tests.edn \
        --plugin cloverage \
        --cov-output test-results/coverage \
        --plugin kaocha.plugin/junit-xml \
        --junit-xml-file test-results/kaocha/results.xml

clojure -Mclj-kondo --lint src
