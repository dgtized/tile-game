{:paths ["src"]
 :deps {io.github.dgtized/carrier
        {:git/url "https://github.com/dgtized/carrier.git"
         :git/sha "37b6acc4c2e4dad0971b150c1a99f666e92a996f"}}
 :tasks
 {:requires ([babashka.fs :as fs]
             [carrier.tasks :as t])
  clean
  {:task (do (println "Remove target directory")
          (fs/delete-tree "target"))}
  lint
  {:doc "Lint source and test with clj-kondo"
   :task (clojure "-Mclj-kondo --parallel --lint src test")}
  compile
  {:depends [clean]
   :doc "Compile release with figwheel"
   :task (clojure "-Mfig -m figwheel.main -bo release")}
  create-static-site
  {:doc "Create release in static-site"
   :task (t/build-static-site
          :build-dir "target/public/cljs-out/"
          :from "resources/public"
          :to "static-site")}
  rewrite-index
  {:doc "Rewrite index from resources/public/index.html for paths in static-site"
   :task (t/rewrite-index
          :build-dir "target/public/cljs-out/"
          :from "resources/public/index.html"
          :to "static-site/index.html"
          :base-href "https://dgtized.github.io/tile-game/")}

  build
  {:depends [compile create-static-site rewrite-index]}

  view
  {:task (shell "xdg-open static-site/index.html")}}}
